{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "tsconfig.json",
    "plugins": ["@nestjs/swagger/plugin"],
    "assets": ["**/*.jpeg", "**/*.hbs", "mail/templates/**/*.tsx"],
    "watchAssets": true
  }
}
